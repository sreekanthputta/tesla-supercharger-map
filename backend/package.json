{
  "name": "tesla-supercharger-scraper",
  "version": "1.0.0",
  "description": "Tesla Supercharger data scraper and API",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "scrape": "node scraper.js",
    "scrape:real": "node scraper-real-data.js",
    "scrape:simple": "node scraper-simplified.js",
    "sample": "node create-sample-data.js",
    "db": "node database.js",
    "db:reset": "rm -f ./data/stations.db && node database.js",
    "setup": "npm run sample && npm run db",
    "start": "node server.js",
    "dev": "nodemon server.js"
  },
  "dependencies": {
    "better-sqlite3": "^9.2.2",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "p-limit": "^5.0.0",
    "puppeteer": "^21.11.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  }
}
